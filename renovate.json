{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "enabledManagers": [
    "github-actions",
    "pep621",
    "pip_requirements",
    "pre-commit",
    "nix",
    "custom.regex"
  ],
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the dogpile.cache release tag in the Dogpile Cache workflow. The tags have the form rel_1_5_0.",
      "managerFilePatterns": ["/^\\.github/workflows/dogpile-cache\\.yml$/"],
      "matchStrings": ["DOGPILE_CACHE_REF:\\s*(?<currentValue>rel_\\d+_\\d+_\\d+)"],
      "depNameTemplate": "sqlalchemy/dogpile.cache",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^rel_(?<major>\\d+)_(?<minor>\\d+)_(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group every patch and minor update into one pull request.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major updates",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Keep each major update in its own pull request.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
